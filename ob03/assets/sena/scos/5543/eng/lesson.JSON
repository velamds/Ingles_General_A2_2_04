 [{"content": "taxi", "type": "name"}, {"content": "a car whose driver you pay money to take you to a place", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I was in a taxi. We got in an accident.", "type": "example"}, {"content": "engenn5le04ob03aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "wrong way", "type": "name"}, {"content": "the incorrect direction", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: We went the wrong way on Lombard Street. ", "type": "example"}, {"content": "engenn5le04ob03aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "police station", "type": "name"}, {"content": "the place where police officers work", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'm in a police station. ", "type": "example"}, {"content": "engenn5le04ob03aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "report", "type": "name"}, {"content": "a document someone writes", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The police officers asked me to fill out a report.", "type": "example"}, {"content": "engenn5le04ob03aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "cable car", "type": "name"}, {"content": "a type of bus used in San Francisco", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We got into an accident with a couple of cable cars.", "type": "example"}, {"content": "engenn5le04ob03aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Think of a strange situation for an accident.", "type": "text"}, {"content": "Write the dialogue. One person asks questions. The other person explains what happened. Be creative!", "type": "text"}, {"content": "Write 8 - 10 lines.", "type": "text"}, {"content": "Practice your dialogue with a partner.", "type": "text"}, {"content": "Change roles.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I write a dialogue of 8 - 10 lines about a strange situation.", "type": "text"}, {"content": "I practice the dialogue with a partner.", "type": "text"}, {"content": "I change roles in a dialogue about a situation.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"type": "welcome", "_data": [], "contents": [{}], "id": 0, "template_override": 1}, {"title": "", "contents": [{"value": {"audiosrc": "engenn5le04ob03re2aud01", "images": [{"image": "engenn5le04ob03re2img06.jpg", "id": 0, "time": "0", "text": ""}, {"image": "engenn5le04ob03re2img06.jpg", "id": 1, "time": "100", "text": "<span class=\"strong\">Vanessa</span>:  Hello???  Peter??? Are you ok?</br>\n<span class=\"strong\">Peter</span>:  Oh hi Vanessa, you're home!</br>\n<span class=\"strong\">Vanessa</span>:  What happened?</br>\n<span class=\"strong\">Peter</span>:  Well, I was in a taxi. We got into an accident with a couple of cable cars and a lot of angry tourists.</br>\n<span class=\"strong\">Vanessa</span>:  How did that happen?"}, {"image": "engenn5le04ob03re2img01.jpg", "id": 2, "time": "21000", "text": "<span class=\"strong\">Peter</span>: We went the wrong way on Lombard Street. It was a very steep hill. We didn't see the cable cars coming.</br>\n<span class=\"strong\">Vanessa</span>: Where are you now?</br>\n<span class=\"strong\">Peter</span>: Well, I'm not really sure.  I'm in a police station. </br>\n<span class=\"strong\">Vanessa</span>: When are you coming?"}, {"image": "engenn5le04ob03re2img05.jpg", "id": 3, "time": "35200", "text": "<span class=\"strong\">Peter</span>: Well, there are some nice police officers here. They told me I can leave in a few hours.</br>\n<span class=\"strong\">Vanessa</span>: Why do you have to wait?</br>\n<span class=\"strong\">Peter</span>: They have some questions for me and I have to fill out a report.</br>\n<span class=\"strong\">Vanessa</span>:  Oh, Peter!"}], "coverimg": "engenn5le04ob03re2img06.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "id": 1}], "exercises": [{"id": 0, "stimuli_ids": [0], "template_override": 1, "_data": [{"contents": [{"content": "I can talk or report about  actions, events or people.", "type": "Learning Outcomes"}, {"content": "I can ask questions using words like what, when, how.", "type": "Learning Outcomes"}, {"content": "I can talk about general quantities using words like some and many. ", "type": "Learning Outcomes"}, {"content": "Were you in an accident? When?", "type": "Free Header Item"}, {"content": "What happened?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct"}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "You won't believe what happened!", "type": "free_type_text_area"}], "type": "WLC", "img_path": "", "questions": []}, {"id": 1, "stimuli_ids": [1], "template_override": 1, "_data": [{"contents": [{"content": "Peter tells Vanessa what happened since he arrived in San Francisco.", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Content", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!"}, "type": "feedback"}, {"contents": [{"conte