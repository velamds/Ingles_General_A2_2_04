ype": "target_word_describer", "contents": [{"content": "These are words you hear in a conversation about a city.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "yolk ", "type": "name"}, {"content": "the yellow part in the center of an egg ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: My eggs looked more grey than yellow. It must be the yolks.", "type": "example"}, {"content": "engenn5le04ob04aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "fog ", "type": "name"}, {"content": "many small drops of water floating in the air making it hard to see ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There is a lot of fog in the summer in San Francisco.", "type": "example"}, {"content": "engenn5le04ob04aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "sprint  ", "type": "name"}, {"content": " to run or go very fast for a short distance ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Get ready for a ten-mile sprint!", "type": "example"}, {"content": "engenn5le04ob04aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "joker  ", "type": "name"}, {"content": "a person who tells or makes many jokes  ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I was always the joker of the group.", "type": "example"}, {"content": "engenn5le04ob04aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "trail", "type": "name"}, {"content": "a path through a forest or field ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We can jog along the bay trail tomorrow.", "type": "example"}, {"content": "engenn5le04ob04aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to head up ", "type": "name"}, {"content": "to go upwards along a path, mountain, or trail ", "type": "definition"}, {"content": " (verb)", "type": "part_speech"}, {"content": "Example: We head up the mountain this afternoon.", "type": "example"}, {"content": "engenn5le04ob04aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "out the window  ", "type": "name"}, {"content": "gone or wasted ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: My routine is out the window.", "type": "example"}, {"content": "engenn5le04ob04aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "bloated  ", "type": "name"}, {"content": "very swollen; too full of food or liquid   ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I feel bloated after that meal.", "type": "example"}, {"content": "engenn5le04ob04aud09", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "current  ", "type": "name"}, {"content": "movement of water or air", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The ocean currents can affect the weather.", "type": "example"}, {"content": "engenn5le04ob04aud10", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Say these minimal pairs aloud with a partner.", "type": "text"}, {"content": "Choose 8 words from the table. (4 <span class=\"italic\">Y</span> words and 4 <span class=\"italic\">J</span> words)", "type": "text"}, {"content": "Write 4 sentences.  Each sentence must contain 1 word starting with <span class=\"italic\">Y</span> and <span class=\"italic\">J</span>.", "type": "text"}, {"content": "Read the sentences aloud to a partner.", "type": "text"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"><span class=\\\"italic\\\">Y</span> sound</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"yam, yard, 