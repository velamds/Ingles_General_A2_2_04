, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn5le04ob01re2aud01", "coverimg": "engenn5le04ob01re2img05.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn5le04ob01re2img05.jpg"}, {"text": "Dear Vanessa,</br></br>\nI'm writing to tell you that I'm coming to San Francisco to visit you! I decided that it's just too long to wait until summer vacation to see you! I told my boss that I'm taking two weeks off. She said that it was OK with her. I'm arriving on December 15th, so we'll get ready for Christmas together!", "id": 1, "time": "100", "image": "engenn5le04ob01re2img05.jpg"}, {"text": "Don't worry about meeting me at the airport. I spoke to my cousin, Wendy, and she's picking me up. I know it's hard for you to get there without a car.", "id": 2, "time": "16500", "image": "engenn5le04ob01re2img05.jpg"}, {"text": "I think we're taking off at 9 in the morning and landing around 11:00 San Francisco time. I'm really looking forward to seeing where you live and meeting your friends!\n</br></br>\nSee you soon!\n</br></br>\nThinking of you, </br>\nPeter", "id": 3, "time": "24000", "image": "engenn5le04ob01re2img01.jpg"}]}}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Peter Visits Vanessa in San Francisco"}, {"type": "unit_name", "content": "The E-mail"}, {"type": "position", "content": 1}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 4}, {"type": "level", "content": "A2.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about people's jobs and places of work in communicative situations."}, {"type": "secondary_1", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. "}, {"type": "secondary_2", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. "}, {"type": "secondary_3", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. "}, {"type": "secondary_4", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. "}, {"type": "secondary_5", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. "}, {"type": "secondary_6", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. "}, {"type": "secondary_7", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. "}, {"type": "secondary_8", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. "}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use when you write an e-mail."}]}, {"type": "background_image", "content": "engenn5le04ob01re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Simple Past Tense"}, {"type": "describer", "content": "You use the Simple Past tense to talk about events that are finished."}, {"type": "text", "content": "Simple Past tense verbs can be regular or irregular.</br> Regular verbs end in <span class=\"strong\">-ed</span> or <span class=\"strong\">-ied</span>.</br>  Irregular verbs change in different ways.</br> For questions in the past, you use the auxiliary <span class=\"italic\">did</span> followed by the verb in the base form, like <span class=\"italic\">Did you ask ... ?</span>.</br>  <span class=\"italic\">Did</span> is the past form of <span class=\"italic\">to do</span>."}, {"type": "table", "content": "{\"rows\":9,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Simple Past Tense\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to decide\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"decided\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to copy\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"copied\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to protect\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"protected\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to lose\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"lost\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to have\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"had\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to say\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"said\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to speak\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"spoke\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to think\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"thought\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Simple Present vs. Present Continuous Tenses"}, {"type": "describer", "content": " "}, {"type": "text", "content": "You use the Simple Present tense to talk about:"}, {"type": "text", "content": "<ul> <li>a routine action or specific action that happens regularly</li> <li>a general truth</li> <li>to give personal information</li> </ul> "}, {"type": "text", "content": "You can use expressions of frequency like every day or always with the Present Simple."}, {"type": "text", "content": "You form the Present Continuous with the verb <span class=\"strong\">to be + verb-ing</span>.</br></br>  You use the Present Continuous tense to talk about:"}, {"type": "text", "content": "<ul> <li>a current event or action happening around now</li> <li>events that <span class=\"strong\">are going to happen</span> soon (future plans)</li> </ul> "}, {"type": "text", "content": "You can use expressions like <span class=\"italic\">right now</span> or <span class=\"italic\">later</span> with the Present Continuous."}, {"type": "table", "content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Present Tense\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Present Continuous Tense\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I know it's hard for you to get there without a car.</br></br> Don't worry about meeting me at the airport. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I'm writing to tell you that I'm coming to San Francisco.</br></br>  I'm arriving on December 15th.</span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "dear"}, {"type": "definition", "content": "A salutation you use at the beginning of a letter or e-mail"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example:  Dear Vanessa, ... "}, {"type": "audio", "content": "engenn5le04ob01aud01"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "vacation"}, {"type": "definition", "content": "time away from work"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I decided that it's just too long to wait until summer vacation to see you! "}, {"type": "audio", "content": "engenn5le04ob01aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to take time off"}, {"type": "definition", "content": "to stop working for a period of time"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I told my boss that I'm taking two weeks off and she said that it was OK with her. "}, {"type": "audio", "content": "engenn5le04ob01aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "Christmas"}, {"type": "definition", "content": "traditional celebration on December 25th"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I'm arriving on December 15th, so we'll get ready for Christmas together!"}, {"type": "audio", "content": "engenn5le04ob01aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "spoke"}, {"type": "definition", "content": "the verb <span class=\"italic\">to speak</span> in the Simple Past tense"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I spoke to my cousin, Wendy."}, {"type": "audio", "content": "engenn5le04ob01aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to pick up"}, {"type": "definition", "content": "to get someone from a certain place, usually in a car"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: She's picking me up from the airport when I arrive."}, {"type": "audio", "content": "engenn5le04ob01aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "flight details"}, {"type": "definition", "content": "information about an airplane flight, such as time of departure and arrival"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I'll send you the flight details when I get them."}, {"type": "audio", "content": "engenn5le04ob01aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "car"}, {"type": "definition", "content": "a motorized vehicle"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example:  I know it's hard for you to get there without a car. "}, {"type": "audio", "content": "engenn5le04ob01aud08"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Choose 7 different countries."}, {"type": "text", "content": "Go online. Find out how many vacation days people in each country are entitled to each year."}, {"type": "text", "content": "Write down countries and the days in order from highest to lowest. "}, {"type": "text", "content": "Discuss your findings with a partner. Which country has the best system?"}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I research vacation days in 7 countries."}, {"type": "text", "content": "I write the list in order from highest to lowest."}, {"type": "text", "content": "I discuss the list of countries and vacation days with a partner."}]}], "type": "sena"}